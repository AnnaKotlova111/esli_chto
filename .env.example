# Скопируйте в .env и заполните. Файл .env не попадает ни в репозиторий, ни в Docker-образ.

# Токен бота MAX. Без токена запускается только мини-приложение (бот выключен) – так можно проверить сборку.
BOT_TOKEN=

# Ник бота без @ – нужен для кнопок «Открыть карту дома». Если пусто, берётся из ответа MAX на запрос /me.
BOT_USERNAME=

# Публичный HTTPS-адрес приложения, например https://esli-chto.example.org
# Если задан – бот работает через вебхук, иначе через long polling (публичный адрес не нужен; так работает рабочий бот).
PUBLIC_URL=

# Если у бота уже есть вебхук (его обслуживает другой сервер в режиме вебхука), long polling не запускается,
# чтобы не отключить его. 1 – запустить всё равно (подписка на вебхук будет снята). Обычно оставьте пустым.
FORCE_POLLING=

# Секрет вебхука (5–256 символов: латиница, цифры, _ и -). MAX присылает его в заголовке каждого события.
# Если оставить пустым – сервер сгенерирует случайный секрет при запуске.
WEBHOOK_SECRET=

# Путь вебхука на сервере. Пусто – /max/webhook.
WEBHOOK_PATH=

# Сколько событий в минуту обрабатывать от одного пользователя (защита от спама).
RATE_LIMIT_PER_MINUTE=20

# Сколько миллисекунд ждать ответа MAX API, прежде чем считать запрос зависшим. Пусто – 60000.
MAX_API_TIMEOUT_MS=

# Порт на хосте (внутри контейнера всегда 8080).
APP_PORT=8080

# Домен для профиля https: Caddy получит сертификат автоматически. Если пусто – localhost с локальным
# самоподписанным сертификатом (только для пробы, MAX такой адрес не примет).
DOMAIN=
