# Скопируйте в .env и заполните. Файл .env не попадает ни в репозиторий, ни в Docker-образ.

# Токен бота MAX. Без токена запускается только мини-приложение (бот выключен) – так можно проверить сборку.
BOT_TOKEN=

# Ник бота без @ – нужен для кнопок «Открыть карту дома». Если пусто, берётся из ответа MAX на запрос /me.
BOT_USERNAME=

# Публичный HTTPS-адрес приложения, например https://esli-chto.example.org
# Если задан – бот работает через вебхук (режим для продакшена), иначе через long polling (для разработки).
PUBLIC_URL=

# Секрет вебхука (5–256 символов: латиница, цифры, _ и -). MAX присылает его в заголовке каждого события.
# Если оставить пустым – сервер сгенерирует случайный секрет при запуске.
WEBHOOK_SECRET=

# Сколько событий в минуту обрабатывать от одного пользователя (защита от спама).
RATE_LIMIT_PER_MINUTE=20

# Порт на хосте (внутри контейнера всегда 8080).
APP_PORT=8080

# Домен для профиля https: Caddy получит сертификат автоматически.
DOMAIN=
